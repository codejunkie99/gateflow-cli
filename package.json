{
    "name": "gateflow-cli",
    "version": "1.0.0",
    "description": "CLI tool for AI-powered SystemVerilog development",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "gateflow": "./dist/index.js",
        "gateflow-mcp": "./packages/claude-plugin/servers/gateflow-mcp/dist/index.js"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "keywords": [
        "systemverilog",
        "verilog",
        "hdl",
        "hardware",
        "ai",
        "cli",
        "verilator",
        "lint",
        "code-generation",
        "testbench"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/your-org/cursor-for-vhdl.git",
        "directory": "cli"
    },
    "license": "BSL-1.1",
    "dependencies": {
        "ink": "^5.0.1",
        "ink-spinner": "^5.0.0",
        "ink-text-input": "^6.0.0",
        "@ai-sdk/anthropic": "^3.0.2",
        "@ai-sdk/google": "^3.0.10",
        "@ai-sdk/mistral": "^3.0.9",
        "@ai-sdk/openai": "^3.0.12",
        "@modelcontextprotocol/sdk": "^1.26.0",
        "@openrouter/ai-sdk-provider": "^2.0.2",
        "@types/blessed": "^0.1.27",
        "ai": "^6.0.0",
        "blessed": "^0.1.81",
        "chalk": "^5.3.0",
        "chokidar": "^3.6.0",
        "commander": "^12.1.0",
        "diff": "^5.2.0",
        "dotenv": "^17.2.3",
        "glob": "^10.3.0",
        "picomatch": "^4.0.3",
        "react": "^18.3.1",
        "tar": "^7.5.2",
        "zod": "^3.23.0"
    },
    "devDependencies": {
        "@types/diff": "^5.2.0",
        "@types/node": "^20.10.0",
        "@types/picomatch": "^4.0.2",
        "@types/tar": "^6.1.13",
        "@types/react": "^18.3.3",
        "tsx": "^4.19.0",
        "typescript": "^5.3.3",
        "vitest": "^2.0.0"
    },
    "scripts": {
        "build": "tsc && npm run copy-assets",
        "copy-assets": "node -e \"const fs=require('fs');const p=require('path');const assets=[['src/waveform/web/viewer.html','dist/waveform/web/viewer.html'],['src/agent/model-capabilities/default-cache.json','dist/agent/model-capabilities/default-cache.json']];assets.forEach(([src,dst])=>{fs.mkdirSync(p.dirname(dst),{recursive:true});fs.copyFileSync(src,dst);console.log('Copied '+src+' to dist')})\"",
        "dev": "tsx src/index.ts",
        "start": "node dist/index.js",
        "lint": "tsc --noEmit",
        "test": "vitest",
        "test:unit": "vitest run",
        "prepublishOnly": "npm run build",
        "postinstall": "node scripts/download-verible.js || echo 'Verible download skipped'",
        "verible:download": "node scripts/download-verible.js",
        "verible:check": "verible-verilog-syntax --version || echo 'Verible not found'",
        "slang:download": "node scripts/download-slang.js",
        "slang:check": "slang --version || echo 'slang not found'",
        "refresh-cache": "node scripts/refresh-model-cache.js"
    }
}
