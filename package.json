{
    "name": "gateflow-cli",
    "version": "1.0.0",
    "description": "CLI tool for AI-powered SystemVerilog development",
    "type": "module",
    "main": "dist/index.js",
    "bin": {
        "gateflow": "./dist/index.js"
    },
    "engines": {
        "node": ">=18.0.0"
    },
    "keywords": [
        "systemverilog",
        "verilog",
        "hdl",
        "hardware",
        "ai",
        "cli",
        "verilator",
        "lint",
        "code-generation",
        "testbench"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/your-org/cursor-for-vhdl.git",
        "directory": "cli"
    },
    "license": "MIT",
    "dependencies": {
        "@ai-sdk/anthropic": "^3.0.2",
        "@modelcontextprotocol/sdk": "^1.25.1",
        "@types/blessed": "^0.1.27",
        "ai": "^6.0.0",
        "blessed": "^0.1.81",
        "chalk": "^5.3.0",
        "chokidar": "^3.6.0",
        "commander": "^12.1.0",
        "diff": "^5.2.0",
        "dotenv": "^17.2.3",
        "glob": "^10.3.0",
        "ora": "^8.1.1",
        "picomatch": "^4.0.3",
        "readline-sync": "^1.4.10",
        "tar": "^7.5.2",
        "zod": "^3.23.0"
    },
    "devDependencies": {
        "@types/diff": "^5.2.0",
        "@types/node": "^20.10.0",
        "@types/picomatch": "^4.0.2",
        "@types/readline-sync": "^1.4.8",
        "@types/tar": "^6.1.13",
        "tsx": "^4.19.0",
        "typescript": "^5.3.3",
        "vitest": "^2.0.0"
    },
    "scripts": {
        "build": "tsc && npm run copy-assets",
        "copy-assets": "node -e \"const fs=require('fs');const p=require('path');const src='src/waveform/web/viewer.html';const dst='dist/waveform/web/viewer.html';fs.mkdirSync(p.dirname(dst),{recursive:true});fs.copyFileSync(src,dst);console.log('Copied viewer.html to dist')\"",
        "dev": "tsx src/index.ts",
        "start": "node dist/index.js",
        "lint": "tsc --noEmit",
        "test": "vitest",
        "test:unit": "vitest run",
        "prepublishOnly": "npm run build",
        "postinstall": "node scripts/download-verible.js || echo 'Verible download skipped'",
        "verible:download": "node scripts/download-verible.js",
        "verible:check": "verible-verilog-syntax --version || echo 'Verible not found'",
        "slang:download": "node scripts/download-slang.js",
        "slang:check": "slang --version || echo 'slang not found'"
    }
}
