# GateFlow CLI - AI Provider Configuration
# Copy this file to .env and add at least one API key.
#
# Usage:
#   gateflow chat "explain counter.sv"                    # Uses first available provider
#   gateflow chat --model openai/gpt-5.2 "review code"    # Specify provider/model
#   gateflow chat
#   > /model                                              # List available providers in REPL
#   > /model google/gemini-3-flash                        # Switch provider in REPL

# =============================================================================
# AI Provider API Keys (set at least ONE)
# =============================================================================
#
# IMPORTANT: When copying API keys:
#   - Copy ONLY the key text (no surrounding quotes)
#   - Make sure there are no leading/trailing spaces
#   - Keys should NOT contain newlines or extra characters
#
# Troubleshooting:
#   - If validation fails, check the key format matches the expected pattern
#   - Make sure your account has credits/billing enabled
#   - Some providers require prepaid credits (Anthropic requires $5 minimum)

# Anthropic (Claude) - Recommended for SystemVerilog
# Get key at: https://console.anthropic.com/settings/keys
# Format: sk-ant-api03-[93 chars]AA (always ends with AA, ~107 chars total)
# Models: claude-opus-4-5-20251101, claude-sonnet-4-20250514, claude-haiku-4-5-20251201
ANTHROPIC_API_KEY=

# OpenAI (GPT)
# Get key at: https://platform.openai.com/api-keys
# Format: sk-[proj-|svcacct-|admin-][chars]T3BlbkFJ[chars] (contains base64 "OpenAI" marker)
# Legacy: 51 chars | Project: ~164 chars
# Models: gpt-5.2, gpt-5, o3, o3-pro, o4-mini, gpt-4o, gpt-4o-mini
OPENAI_API_KEY=

# Google (Gemini)
# Get key at: https://aistudio.google.com/apikey
# Format: AIza[35 chars] (EXACTLY 39 characters total, starts with AIza)
# Models: gemini-2.5-pro, gemini-2.5-flash, gemini-2.5-flash-lite
GOOGLE_GENERATIVE_AI_API_KEY=

# xAI (Grok)
# Get key at: https://console.x.ai/team
# Format: xai-[20+ alphanumeric chars]
# Models: grok-4.1-fast, grok-4.1, grok-4, grok-3
XAI_API_KEY=

# DeepSeek
# Get key at: https://platform.deepseek.com/api_keys
# Format: sk-[32 LOWERCASE alphanumeric chars] (exactly 35 chars total)
# Note: Must be lowercase only (unlike OpenAI)
# Models: deepseek-chat, deepseek-reasoner, deepseek-coder
DEEPSEEK_API_KEY=

# Zhipu (GLM) - 智谱AI
# Get key at: https://open.bigmodel.cn/usercenter/apikeys
# Format: [32-char hex].[secret] (two parts separated by dot)
# Example: 39c8c7b4d7584d6dbf05516cca9c72f4.Avx1htdBdB1RZpE1
# Models: glm-4.7, glm-4.6, glm-4.5, glm-4-flash
ZHIPU_API_KEY=

# MiniMax
# Get key at: https://platform.minimax.io
# Format: 20+ alphanumeric chars (varies by region)
# Note: May also require MINIMAX_GROUP_ID for Chinese region
# Models: abab6.5-chat, abab6.5s-chat, abab5.5-chat
MINIMAX_API_KEY=
# MINIMAX_GROUP_ID=  # Required for api.minimaxi.com (China)

# =============================================================================
# Additional Providers (Phase 1 Enhancements)
# =============================================================================

# OpenRouter (300+ models with single API key)
# Get key at: https://openrouter.ai/keys
# Format: sk-or-v1-[64 hex chars]
# Models: anthropic/claude-sonnet-4, openai/gpt-5, google/gemini-2.5-pro, meta-llama/llama-3.3-70b-instruct
OPENROUTER_API_KEY=

# Groq (Fast inference)
# Get key at: https://console.groq.com/keys
# Format: gsk_[50+ alphanumeric chars]
# Models: llama-3.3-70b-versatile, llama-3.1-8b-instant, mixtral-8x7b-32768
GROQ_API_KEY=

# Mistral AI
# Get key at: https://console.mistral.ai/api-keys/
# Format: 32 alphanumeric chars
# Models: mistral-large-latest, mistral-medium-latest, codestral-latest
MISTRAL_API_KEY=

# Ollama (Local models - no API key required)
# Install at: https://ollama.ai/download
# Default: http://localhost:11434/v1 (set custom URL below if different)
# Models: llama3.1, llama3.1:70b, codellama, deepseek-coder-v2
# OLLAMA_BASE_URL=http://localhost:11434/v1

# =============================================================================
# Tool Configuration (optional)
# =============================================================================

# Path to Verilator binary (uses system PATH if not set)
# VERILATOR_PATH=/usr/bin/verilator

# Path to Slang binary (auto-downloaded if not set)
# SLANG_PATH=/usr/local/bin/slang

# Path to Verible binaries (auto-downloaded if not set)
# VERIBLE_PATH=/usr/local/bin
